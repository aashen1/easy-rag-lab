# ========================================
# LLM API Configuration
# ========================================
# Fallback Mechanism:
#   - Specific env vars (e.g., LLM_KEY_OPUS) take priority
#   - If not set, fallback to generic vars (LLM_API_KEY, LLM_BASE_URL)
#   - This allows using one key for all models, or separate keys per model

# Generic API Configuration (used as fallback)
LLM_API_KEY="ak_yourkey"
LLM_BASE_URL="https://api.longcat.chat/"
LLM_MODEL_ID="LongCat-Flash-Lite"

# Model-Specific Configuration (optional, overrides generic)
# Uncomment and fill when you have separate keys for different models

# For Opus model preset
# LLM_KEY_OPUS="ak_opus_key"
# LLM_URL_OPUS="https://api.longcat.chat/"

# For Sonnet model preset
# LLM_KEY_SONNET="ak_sonnet_key"
# LLM_URL_SONNET="https://api.longcat.chat/"

# For Haiku model preset
# LLM_KEY_HAIKU="ak_haiku_key"
# LLM_URL_HAIKU="https://api.longcat.chat/"

# ========================================
# Optional: Hugging Face Configuration
# ========================================
# Set cache directory for Hugging Face models
# HF_HOME=./.cache/huggingface

# ========================================
# Optional: Logging Configuration
# ========================================
# LOG_LEVEL=INFO
